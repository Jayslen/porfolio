---
import { Image } from 'astro:assets';
import LinkIcon from '../assets/Link.svg'
import {images} from '../utils/getIcons'
import { buildPathImage } from '../utils/buildIconSrc';

interface Props {
    Content: {
        title: string;
        projects: {
            title: string;
            description: string;
            technologies: string[];
            repository: string;
            site?: string;
        }[];
    };
}


const {
    Content: { title, projects },
} = Astro.props;
---

<section class="mx-5 sm:mx-20 md:mx-6 xl:mx-44 2xl:mx-72 mb-14">
    <h2 class="text-4xl mb-6 font-extrabold">{title}</h2>
    <ul class="grid grid-cols-[repeat(auto-fit,minmax(420px,1fr))] gap-3 items-start">
        {
            projects.map((item) => {
                return (
                    <li class="flex flex-col p-2.5 rounded-[5px] bg-[#272727] h-full self-start hover:bg-[#00000057] group transition-colors duration-300">
                        <header class="flex items-center justify-between">
                            {item.site ?
                              <a href={item.site} target="blank" class="flex gap-1 items-center group/link *:">
                                <h4 class="font-bold">{item.title}</h4>
                                    <LinkIcon class="text-current"/>
                              </a> : <h4 class="font-bold">{item.title}</h4>
                              }
                            <a href={item.repository} target="blank">
                                <Image src={images["/src/assets/icons/github.png"]()} class="w-6 object-center" alt="Github logo"></Image>
                            </a>
                        </header>Vitest
                        <p>{item.description}</p>
                        <ul class="flex flex-wrap gap-2">
                            {item.technologies.map((tech) => {
                            const path = buildPathImage(tech);
                            return <li class="flex gap-2.5 items-center h-7 py-1 px-2.5 rounded-sm bg-[#00000057] italic group-hover:bg-[#272727]">
                                <Image src={path} class="h-4 w-4" alt=`${tech} Logo`></Image>
                                <span>{tech}</span>
                            </li>
                            })}
                        </ul>
                    </li>
                );
            })
        }
    </ul>
</section>

<style>
   h2 + ul > li {
        border: 0.5px solid #636363;
    }
</style>
