---
interface Props {
    Content: {value: string, id:string}[];
}
const currentLocale = Astro.currentLocale;
const { Content } = Astro.props;
---

<nav
    class="fixed sm:mx-left md:left-6 xl:left-44 right:left-72 top-8 p-4 py-2 rounded-full bg-[#BDCA58]/90 text-black text-sm hover:bg-white/25 transition-colors z-50"
>
    <ul class="flex gap-4">
        {
            Content.map(({value,id}) => (
                <li class="font-medium hover:text-white transition-colors">
                    <a href={`#${id}`}>{value}</a>
                </li>
            ))
        }
    </ul>
</nav>
