---
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import HeroSsection from "./HeroSsection.astro";
import { getTranslations } from "../i18n/i18n";
import SkillLists from "./SkillLists.astro";
import WorkExpirienceSection from "./WorkExpirienceSection.astro";
import Projects from "./Projects.astro";
import SkillsSection from "./SkillsSection.astro";
import AboutMe from "./AboutMe.astro";
const { currentLocale } = Astro;

const {
    HEADER_SECTION,
    INTRODUCCION_SECTION,
    EXPIRIENCE_SECTION,
    PROJECT_SECTION,
    SKILLS_SECTION,
    ABOUT_ME_SECTION,
} = getTranslations({
    language: currentLocale,
});
---

<Layout
    title={currentLocale === "es"
        ? "Mi porfolio - Jayslen Rojas Serrano"
        : "My porfolio - Jayslen Rojas Serrano"}
    lang={currentLocale}
>
w    <!-- <Header Content={HEADER_SECTION} /> -->
    <main class="relative flex flex-col gap-20">
        <HeroSsection translation={INTRODUCCION_SECTION} />
        <SkillLists />
        <WorkExpirienceSection content={EXPIRIENCE_SECTION} />
        <Projects Content={PROJECT_SECTION} />
        <SkillsSection Content={SKILLS_SECTION} />
        <AboutMe Content={ABOUT_ME_SECTION} />
    </main></Layout
>
