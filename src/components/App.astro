---
import Header from "../components/Header.astro";
import Layout from "../layouts/Layout.astro";
import AboutMeSection from "../components/AboutMeSection.astro";
import { getTranslations } from "../i18n/i18n";
import SkillLists from "./SkillLists.astro";
import WorkExpirienceSection from "./WorkExpirienceSection.astro";
const { currentLocale } = Astro;

const DATA = getTranslations({ language: currentLocale });
---

<Layout
    title={currentLocale === "es"
        ? "Mi porfolio - Jayslen Rojas Serrano"
        : "My porfolio - Jayslen Rojas Serrano"}
    lang={currentLocale}
>
    <Header translation={DATA.HEADER_SECTION} />
    <main class="relative flex flex-col gap-20">
        <AboutMeSection translation={DATA.INTRODUCCION_SECTION} />
        <SkillLists />
        <WorkExpirienceSection />
    </main>
</Layout>
