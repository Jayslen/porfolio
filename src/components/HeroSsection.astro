---
import Email from "../assets/mail.svg";
import CV from "../assets/CV.svg";

const {
    translation: { INTRODUCCION_SECTION_TITLE, SUB_TITLE, SHORT_DESCRIPTION },
} = Astro.props;
const lang = Astro.currentLocale;

const PDF_FILE =
    lang === "es" ? "/public/CV-spanish.pdf" : "public/CV-english.pdf";
---

<section
    title={INTRODUCCION_SECTION_TITLE}
    id="about-me"
    class="mx-5 sm:mx-20 md:mx-6 xl:mx-44 2xl:mx-72 mb-14"
>
    <div class="flex justify-between items-center mt-20 w-full">
        <article class="max-w-xl flex flex-col">
            <span class="text-base font-normal" set:html={SUB_TITLE} />
            <h1
                class="text-5xl xl:text-6xl font-extrabold"
                set:html={INTRODUCCION_SECTION_TITLE}
            />
            <p class="w-full" set:html={SHORT_DESCRIPTION} />

            <div class="flex gap-2">
                <button class="flex justify-center gap-2">
                    <Email width="24" height="24" color={"black"} />
                    Get in touch
                </button>
                <button class="flex justify-center gap-2">
                    <CV width="24" height="24" color={"black"} />
                    CV
                </button>
            </div>
        </article>
        <img src="/jayslen.jpg" class="w-96 rounded-full" />
    </div>
</section>

<style>
    button {
        border-radius: 5px;
        background: linear-gradient(90deg, #dee6a9 0%, #cad677 100%);
        min-width: 150px;
        color: #1b1b1b;
        padding: 8px 4px;
        font-weight: 500;
    }
</style>
